# Copy to .env (chmod 600) and fill in. Never commit .env.
PORT=3230
HOST=127.0.0.1
PUBLIC_URL=https://dmsender.meapi.in
# Database, uploaded payment screenshots and backups live here (outside the git checkout).
DATA_DIR=/www/wwwroot/dmsender.meapi.in/data

# Comma-separated Chrome extension IDs allowed to call /v1 (empty = any extension, fine while testing).
EXTENSION_IDS=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks). Leave empty to use only UPI/bank/PayPal.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email for password resets and "payment to approve" alerts (optional but recommended).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MeAPI DM <noreply@meapi.in>"
NOTIFY_EMAIL=

# Abuse limits
ISSUE_PER_HOUR=10
RATE_PER_MINUTE=120
