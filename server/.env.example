# Copy to .env and fill in.
PORT=8787
PUBLIC_URL=https://license.yourdomain.com
DB_FILE=./data/meapi-dm.sqlite

# Long random string (32+ chars). Used to log into /admin.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Comma-separated Chrome extension IDs allowed to call the API (leave empty while developing).
EXTENSION_IDS=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Abuse limits
ISSUE_PER_HOUR=10
RATE_PER_MINUTE=120
